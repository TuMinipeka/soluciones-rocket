# URL base del servicio backend FastAPI.
# En desarrollo local con el proxy de Vite se puede omitir o apuntar a http://localhost:8000
# En despliegue o Docker Compose, configurar con el host/puerto correspondiente.
VITE_API_URL=http://localhost:8000
