APP_ENV=development
# Ruta dentro del contenedor; mantenla bajo /app/data para usar el volumen campus_data.
DATABASE_URL=sqlite:////app/data/campus.db

# Obligatoria para iniciar la API fuera de pruebas; usa al menos 32 caracteres aleatorios.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcionales para arrancar; obligatorias si ejecutas seed_demo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEACHER_EMAIL=
TEACHER_PASSWORD=
SUPPORT_EMAIL=
SUPPORT_PASSWORD=

# Opcionales: el triaje usa reglas locales cuando no hay proveedor IA configurado.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=15

CORS_ORIGINS=http://localhost:5173
